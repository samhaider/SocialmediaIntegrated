{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=SocialMediaDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "CHANGE_THIS_TO_A_SECURE_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "SocialMediaAPI",
    "Audience": "SocialMediaAPIUsers"
  },
  "MediaStorage": {
    "Path": "uploads"
  },
  "Facebook": {
    "AppId": "YOUR_FACEBOOK_APP_ID",
    "AppSecret": "YOUR_FACEBOOK_APP_SECRET",
    "ApiVersion": "v19.0",
    "GraphApiBaseUrl": "https://graph.facebook.com",
    "RedirectUri": "https://yourdomain.com/api/facebook/oauth/callback",
    "Scopes": [
      "pages_show_list",
      "pages_manage_posts",
      "pages_read_engagement",
      "public_profile",
      "email"
    ],
    "RateLimitPerHour": 200,
    "TokenExchangeUrl": "https://graph.facebook.com/v19.0/oauth/access_token",
    "LongLivedTokenUrl": "https://graph.facebook.com/v19.0/oauth/access_token"
  }
}
